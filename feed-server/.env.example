# The public hostname at which the feed will be served.
FEED_SERVER_HOSTNAME=at.example.com

# Comma-separated names of the feeds to serve.
# When unset, all feeds are served.
# See ALL_FEEDS in src/feed_server/feeds/__init__.py.
#
# FEED_SERVER_ENABLED_FEEDS=chronofair,videos_v0

# Set to 0 to serve only the feed without running the workers.
# Set to 1 to serve the feed and the workers in the same process.
#
# Use 0 when deploying the feed,
# Use 1 during development.
FEED_SERVER_RUN_TASKS_IN_LIFESPAN=1

# Set to 1 (the default) to resume from the last position stored in Redis,
# so that events received while the listener was down are replayed on restart.
# Set to 0 to start from the live stream instead.
#
# Use 1 when deploying (or remove this line),
# Use 0 during development, to avoid processing a large amount of past data.
FEED_SERVER_JETSTREAM_USE_STORED_CURSOR=0

# If you need to modify the Redis connection parameters.
#
# REDIS_URL=redis://localhost:6379
# REDIS_MAX_CONNECTIONS=50
