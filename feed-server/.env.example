# The public hostname at witch the feed will be served.
FEED_SERVER_HOSTNAME=at.example.com

# Set to 0 to serve only the feed without running the workers.
# Set to 1 to serve the feed and the workers in the same process.
#
# Use 0 when deploying the feed,
# Use 1 during development.
FEED_SERVER_RUN_TASKS_IN_LIFESPAN=1

# If you need to modify the Redis connection parameters.
#
# REDIS_URL=redis://localhost:6379
# REDIS_MAX_CONNECTIONS=50
